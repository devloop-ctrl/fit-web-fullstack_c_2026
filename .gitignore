# ==========================================
# FitPulse Security & Environment .gitignore
# ==========================================

# Environment variables & API credentials (CRITICAL FOR SECURITY)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependency directories
node_modules/
client/node_modules/
server/node_modules/

# Production build outputs
dist/
dist-ssr/
build/
client/dist/

# Large archive and backup files
*.rar
*.zip
*.tar.gz
*.7z

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

